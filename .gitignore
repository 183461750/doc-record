# Created by .ignore support plugin (hsz.mobi)
.idea/
.obsidian/
.vscode/

.DS_Store
**/.DS_Store

# 忽略所有临时目录下的文件
**/temp/

actions-runner/_diag/

node_modules
dist
.astro/

# Playwright 本地运行产物
test-results/
playwright-report/

_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# 本地用 bun 安装依赖以绕开文件代理限制，bun.lock 不纳入版本控制
bun.lock

# Weblate 部署凭据
weblate/.env

.frontmatter

db.json

# Graphify - 产物提交到 git，仅忽略机器本地临时文件
graphify-out/.graphify_python
graphify-out/.graphify_uncached.txt

.claude/worktrees/
.gstack/

# WorkBuddy - 本地工作数据，不纳入版本控制
.workbuddy/

# 迁移前 Docusaurus 时代的旧布局目录，本站内容已迁到 src/content/docs/，
# 这里只剩本机残留：旧 .gitignore 忽略过的临时文件、以及本机评审记录
# （docs/reviews/）。内容未入库过，故不纳入版本控制，避免污染 git status 与
# 主项目的子模块状态标记。若评审记录确定要入库，先脱敏并移到 adr/ 等受控目录，
# 再删除本规则。
/docs/
