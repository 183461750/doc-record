---
/**
 * 在 Black 主题的 Head 之上补本项目的元信息。
 *
 * Black 覆盖 Head 是为了注入 Geist 字体（--font-geist / --font-geist-mono）
 * 并渲染 Starlight 的 head 条目；检测到已有覆盖时它会跳过，因此这里必须
 * 手动渲染它的版本，否则字体与部分 head 条目会丢失。
 */
import BlackHead from 'starlight-theme-black/overrides/Head.astro';
import { rawMarkdownPath } from '../lib/raw-path';

const route = Astro.locals.starlightRoute;
const { entry, lang } = route;

const site = Astro.site ?? new URL(Astro.url.origin);
const title = entry.data.title;
const description = entry.data.description;
const publishedAt = entry.data.date;

// `date` 由 z.coerce.date() 解析，宽松输入（纯年份、非法日期）可能得到无效时间；
// 不设保护时 toISOString() 抛出的 RangeError 会中断整站构建，而不是跳过单个页面。
const datePublished = (() => {
  if (!publishedAt) return undefined;
  const parsed = new Date(publishedAt);
  return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString();
})();

// 与页面同路径的 Markdown 原文，供 AI 客户端直接取用
const rawUrl = new URL(rawMarkdownPath(entry.id), site).toString();
const pageUrl = new URL(Astro.url.pathname, site).toString();

// starlight-blog 注入的 RSS 发现链接与其 social 图标一样缺少默认语言的
// 路径前缀（按 site + base + 前缀拼接），指向不存在的地址。这里替换为
// 实际产物路径，避免 RSS 阅读器与搜索引擎取到 404。
const RSS_FEED_PATH = '/zh-cn/blog/rss.xml';
if (Array.isArray(route.head)) {
  route.head = route.head.filter(
    (item) => !(item?.tag === 'link' && item.attrs?.type === 'application/rss+xml'),
  );
  route.head.push({
    tag: 'link',
    attrs: {
      rel: 'alternate',
      type: 'application/rss+xml',
      title: 'Blog',
      href: RSS_FEED_PATH,
    },
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  ...(description ? { description } : {}),
  url: pageUrl,
  inLanguage: lang,
  ...(datePublished ? { datePublished } : {}),
  isPartOf: {
    '@type': 'WebSite',
    name: 'Doc Record',
    url: site.toString(),
  },
};
---

<BlackHead />

<link rel="alternate" type="text/markdown" href={rawUrl} title={`${title}（Markdown 原文）`} />
<link rel="alternate" type="text/plain" href={new URL('/llms-full.txt', site)} title="全站纯文本" />
<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

<!--
  配色必须在首屏绘制前落到 <html>，否则会先闪一下默认色再跳变。
  因此用 is:inline 同步执行，不进打包流程。键名与 PaletteSelect 一致。
-->
<script is:inline>
  try {
    var saved = localStorage.getItem('sl-palette');
    if (saved && saved !== 'default') document.documentElement.dataset.palette = saved;
  } catch (error) {
    // 隐私模式下读取会抛错，按默认配色渲染
  }
</script>
