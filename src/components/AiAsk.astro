---
/**
 * 全站问答的悬浮入口。
 *
 * 问答检索的是全站 Pagefind 索引，与「复制 Markdown / 在 ChatGPT 中打开」这类
 * 只作用于当前文档的操作不同源。此前两者并列在标题区，容易被理解为「问当前
 * 文档」，故把问答拆成全局悬浮入口：任意页面都可发起提问，首页与博客列表也
 * 不再缺失入口。
 */
const t = Astro.locals.t;

/**
 * 问答链路有两套，取决于是否配置了自建生成端。
 *
 * 配置 PUBLIC_AI_ANSWER_URL 时走「浏览器端 Pagefind 召回 + 自建生成端」：
 * Pagefind 索引在构建期生成，中文分词可用，召回在客户端完成且不消耗
 * Workers AI 额度，生成端只负责依据片段作答。
 *
 * 未配置时回退到 NLWeb 的 /ask：英文与标识符可用，含中文的查询会被
 * NLWeb 侧过滤，见 adr/2026-09-14-AI-Search-容量限流调优.md §6.3。
 */
const answerEndpoint = import.meta.env.PUBLIC_AI_ANSWER_URL ?? '';
const nlwebEndpoint =
  import.meta.env.PUBLIC_NLWEB_ASK_URL ??
  'https://bold-union-4896-nlweb.iuinin666.workers.dev/ask';
const useLocalRecall = Boolean(answerEndpoint);
const askEndpoint = useLocalRecall ? answerEndpoint : nlwebEndpoint;
---

<div class="ai-ask-launcher">
  <section
    class="ai-ask-panel"
    hidden
    role="dialog"
    aria-modal="false"
    aria-labelledby="ai-ask-title"
    data-endpoint={askEndpoint}
    data-recall={String(useLocalRecall)}
    data-pending={t('aiAsk.pending')}
    data-empty={t('aiAsk.empty')}
    data-failed={t('aiAsk.failed')}
    data-quota={t('aiAsk.quota')}
    data-sources={t('aiAsk.sources')}
    data-copy={t('aiAsk.copy')}
    data-copied={t('aiAsk.copied')}
    data-retry={t('aiAsk.retry')}
  >
    <div class="ai-ask-head">
      <p class="ai-ask-title" id="ai-ask-title">{t('aiAsk.title')}</p>
      <div class="ai-ask-actions">
        <button
          type="button"
          class="ai-ask-icon ai-ask-clear"
          aria-label={t('aiAsk.clear')}
          title={t('aiAsk.clear')}
          hidden
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 12a9 9 0 1 0 3-6.7"></path>
            <path d="M3 4v5h5"></path>
          </svg>
        </button>
        <button
          type="button"
          class="ai-ask-icon ai-ask-close"
          aria-label={t('aiAsk.close')}
          title={t('aiAsk.close')}
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <p class="ai-ask-hint">{t('aiAsk.hint')}</p>

    <form class="ai-ask-form">
      <input
        class="ai-ask-input"
        type="search"
        name="query"
        required
        aria-label={t('aiAsk.placeholder')}
        placeholder={t('aiAsk.placeholder')}
        autocomplete="off"
        enterkeyhint="send"
      />
      <button class="ai-ask-submit" type="submit">{t('aiAsk.submit')}</button>
    </form>

    <div class="ai-ask-result" role="status" aria-live="polite"></div>
  </section>

  <button type="button" class="ai-ask-open" aria-expanded="false" title={t('aiAsk.label')}>
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 8.5-8.5h.5a8.5 8.5 0 0 1 8 8v.5z"
      ></path>
    </svg>
    <span class="ai-ask-open-text">{t('aiAsk.label')}</span>
  </button>
</div>

<script>
  // HTML → 纯文本与生成端共用同一份实现（代码审查发现项 M7）：此前前端只剥标签、
  // 生成端还会解码实体，两边对同一段 Pagefind 文本给出不同结果
  import { toPlainText } from '../../shared/plain-text.js';
  // 召回逻辑见 shared/recall.js：面板只负责交互与流式渲染，召回可独立评测
  import { MAX_CONTEXTS, recall } from '../../shared/recall.js';

  interface AskResult {
    url?: string;
    name?: string;
    description?: string;
  }

  interface AskMessage {
    message_type?: string;
    results?: AskResult[];
    content?: string;
    answer?: string;
  }

  /** 把 SSE 文本流切成完整的 `data:` 事件载荷。 */
  let warnedUnexpectedEvent = false;

  function parseEvents(chunk: string): AskMessage[] {
    const messages: AskMessage[] = [];
    for (const block of chunk.split('\n\n')) {
      for (const line of block.split('\n')) {
        if (!line.startsWith('data:')) continue;
        const payload = line.slice(5).trim();
        if (!payload || payload === '[DONE]') continue;
        try {
          messages.push(JSON.parse(payload) as AskMessage);
        } catch {
          // 心跳或非 JSON 行直接忽略；首次出现时留一条记录，避免上游换了格式却毫无迹象
          if (!warnedUnexpectedEvent) {
            warnedUnexpectedEvent = true;
            console.warn('[ai-ask] 忽略无法解析的 SSE 数据行：', payload.slice(0, 80));
          }
        }
      }
    }
    return messages;
  }

  function buildSources(label: string, items: AskResult[]): DocumentFragment {
    const fragment = document.createDocumentFragment();

    if (items.length > 0) {
      const heading = document.createElement('p');
      heading.className = 'ai-ask-sources';
      heading.textContent = label;
      fragment.append(heading);

      const list = document.createElement('ol');
      for (const item of items) {
        if (!item.url) continue;
        const entry = document.createElement('li');
        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.name ?? item.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        entry.append(link);
        if (item.description) {
          const text = document.createElement('p');
          text.textContent = item.description;
          entry.append(text);
        }
        list.append(entry);
      }
      fragment.append(list);
    }

    return fragment;
  }

  /**
   * 带状态码的请求失败：上层据此区分「可重试」与「当日额度已耗尽」。
   * 对应生成端的 429（额度用尽，重试无效）与 502/503（容量或未知失败，可重试）。
   */
  class AskRequestError extends Error {
    status: number;

    constructor(status: number) {
      super(`HTTP ${status}`);
      this.status = status;
    }
  }

  /** 逐段读取 SSE，把解析出的消息交给调用方。 */
  async function readStream(response: Response, onMessage: (message: AskMessage) => void) {
    if (!response.body) throw new Error('empty body');
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';

    try {
      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const boundary = buffer.lastIndexOf('\n\n');
        if (boundary === -1) continue;
        const complete = buffer.slice(0, boundary + 2);
        buffer = buffer.slice(boundary + 2);
        for (const message of parseEvents(complete)) onMessage(message);
      }
    } finally {
      // 正常结束、上游出错、被 abort 中断三条路径都要还锁：
      // 取消时若不还锁，底层流不会尽快释放回连接池。
      reader.releaseLock();
    }
  }

  /** 把一段纯文本按行内代码拆开插入（不解析其它 Markdown，保证不执行任何 HTML）。 */
  function appendInlineText(target: HTMLElement, text: string) {
    for (const part of text.split(/(`[^`\n]+`)/g)) {
      if (!part) continue;
      if (part.length > 2 && part.startsWith('`') && part.endsWith('`')) {
        const code = document.createElement('code');
        code.textContent = part.slice(1, -1);
        target.append(code);
      } else {
        target.append(document.createTextNode(part));
      }
    }
  }

  /**
   * 把答案渲染成「文本 + 行内代码 + 围栏代码块」。
   *
   * 生成端会用 Markdown 围栏（```）给出命令，只渲染行内代码会把围栏原样显示出来。
   * 这里只识别围栏与行内代码两种语法，其余按纯文本插入（textContent）——
   * 不引入 Markdown 解析器，也不会把模型输出当成 HTML 执行。
   * 围栏未闭合（模型截断）时按到文末处理，避免把半截内容当正文。
   */
  function renderAnswerInto(target: HTMLElement, text: string) {
    target.replaceChildren();

    const fence = /```([^\n]*)\n([\s\S]*?)(?:\n```|$)/g;
    const segments: { code: boolean; value: string }[] = [];
    let cursor = 0;
    let match: RegExpExecArray | null;
    while ((match = fence.exec(text))) {
      segments.push({ code: false, value: text.slice(cursor, match.index) });
      segments.push({ code: true, value: match[2] });
      cursor = fence.lastIndex;
    }
    segments.push({ code: false, value: text.slice(cursor) });

    // 代码块是块级元素，围栏前后的换行交给它自己的外边距，避免多出空行
    for (let index = 1; index < segments.length; index += 1) {
      const segment = segments[index];
      if (segment.code) segments[index - 1].value = segments[index - 1].value.replace(/\n+$/, '');
      else segment.value = segment.value.replace(/^\n+/, '');
    }

    for (const segment of segments) {
      if (segment.code) {
        const pre = document.createElement('pre');
        const code = document.createElement('code');
        code.textContent = segment.value.replace(/\n$/, '');
        pre.append(code);
        target.append(pre);
      } else if (segment.value) {
        appendInlineText(target, segment.value);
      }
    }
  }

  /** 内容出现后显示「清空」按钮（空面板时隐藏，避免误触）。 */
  function revealClear(panel: HTMLElement) {
    const clearButton = panel.querySelector<HTMLButtonElement>('.ai-ask-clear');
    if (clearButton) clearButton.hidden = false;
  }

  /** 加载态：spinner + 文案，替代原来的一行静止文字。 */
  function renderStatus(panel: HTMLElement, output: HTMLElement, label: string) {
    output.replaceChildren();
    const row = document.createElement('p');
    row.className = 'ai-ask-status';
    const spinner = document.createElement('span');
    spinner.className = 'ai-ask-spinner';
    spinner.setAttribute('aria-hidden', 'true');
    row.append(spinner, document.createTextNode(label));
    output.append(row);
    revealClear(panel);
  }

  /**
   * 失败态：文案 +（可重试时）重试按钮。
   * 额度耗尽（429）不提供重试 —— 重试只会再失败一次，应等到次日额度重置。
   */
  function renderFailure(
    panel: HTMLElement,
    output: HTMLElement,
    message: string,
    onRetry?: () => void,
  ) {
    output.replaceChildren();
    const row = document.createElement('p');
    row.className = 'ai-ask-status';
    row.textContent = message;
    output.append(row);
    if (onRetry) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'ai-ask-action';
      button.textContent = panel.dataset.retry ?? 'Retry';
      button.addEventListener('click', onRetry);
      output.append(button);
    }
    revealClear(panel);
  }

  /** 答案定稿：渲染行内代码、挂复制按钮、把结果区滚到底。 */
  function finishAnswer(panel: HTMLElement, output: HTMLElement, block: HTMLElement, raw: string) {
    const text = raw.trim() || (panel.dataset.empty ?? '');
    const body = block.querySelector<HTMLElement>('.ai-ask-answer-text');
    if (body) renderAnswerInto(body, text);
    const copyButton = document.createElement('button');
    copyButton.type = 'button';
    copyButton.className = 'ai-ask-action ai-ask-copy';
    copyButton.textContent = panel.dataset.copy ?? 'Copy';
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        copyButton.textContent = panel.dataset.copied ?? 'Copied';
        copyButton.disabled = true;
        window.setTimeout(() => {
          copyButton.textContent = panel.dataset.copy ?? 'Copy';
          copyButton.disabled = false;
        }, 1500);
      } catch {
        // 非安全上下文或用户拒绝授权时静默失败，不打断阅读
      }
    });
    block.append(copyButton);
    // 答案是从上往下读的：滚到结果区顶部（答案块就是第一个子节点）。
    // 曾经滚到底部，长答案会把「来源列表尾部」推到眼前，反而遮住回答开头。
    output.scrollTop = 0;
    revealClear(panel);
  }

  /**
   * 本地召回 + 自建生成端：中文查询可用。
   *
   * `signal` 来自当前这次提交：被后一次提交取消后，本函数不得再改动界面，
   * 否则旧请求的输出会盖掉新请求的（答案与来源错配的成因之一）。
   */
  async function askWithLocalRecall(
    panel: HTMLElement,
    output: HTMLElement,
    query: string,
    signal: AbortSignal,
  ) {
    // Pagefind 索引由构建期生成，首次提问时才加载；`astro dev` 下没有该产物，
    // 加载失败由调用方按失败处理（回退链路见文件头说明）。
    const modulePath = '/pagefind/pagefind.js';
    const pagefind = (await import(
      /* @vite-ignore */ modulePath
    )) as unknown as Parameters<typeof recall>[0];
    await pagefind.init();

    const { hits, contexts } = await recall(pagefind, query, {
      origin: window.location.origin,
      limit: MAX_CONTEXTS,
    });

    if (signal.aborted) return;

    if (hits.length === 0) {
      output.textContent = panel.dataset.empty ?? '';
      return;
    }

    output.replaceChildren();
    const block = document.createElement('div');
    block.className = 'ai-ask-answer';
    const answer = document.createElement('p');
    answer.className = 'ai-ask-answer-text';
    block.append(answer);
    output.append(block, buildSources(panel.dataset.sources ?? '', hits));

    const response = await fetch(panel.dataset.endpoint ?? '', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query, contexts }),
      signal,
    });
    if (!response.ok) throw new AskRequestError(response.status);

    await readStream(response, (message) => {
      if (signal.aborted) return;
      const text = message.answer ?? message.content;
      if (typeof text === 'string' && text) answer.textContent += text;
    });

    if (signal.aborted) return;
    finishAnswer(panel, output, block, answer.textContent ?? '');
  }

  /** 回退路径：NLWeb 自行检索并生成，中文查询会被其过滤。 */
  async function askNlweb(
    panel: HTMLElement,
    output: HTMLElement,
    query: string,
    signal: AbortSignal,
  ) {
    const collected: AskResult[] = [];
    const notes: string[] = [];

    const response = await fetch(panel.dataset.endpoint ?? '', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query, mode: 'generate', site: 'all' }),
      signal,
    });
    if (!response.ok) throw new AskRequestError(response.status);

    await readStream(response, (message) => {
      if (signal.aborted) return;
      if (message.results) collected.push(...message.results);
      const text = message.answer ?? message.content;
      if (typeof text === 'string' && text) notes.push(text);
    });

    if (signal.aborted) return;

    output.replaceChildren();
    const block = document.createElement('div');
    block.className = 'ai-ask-answer';
    const answer = document.createElement('p');
    answer.className = 'ai-ask-answer-text';
    block.append(answer);
    output.append(block, buildSources(panel.dataset.sources ?? '', collected));
    finishAnswer(panel, output, block, notes.join(' '));
  }

  document.querySelectorAll<HTMLElement>('.ai-ask-launcher').forEach((launcher) => {
    const openButton = launcher.querySelector<HTMLButtonElement>('.ai-ask-open');
    const closeButton = launcher.querySelector<HTMLButtonElement>('.ai-ask-close');
    const clearButton = launcher.querySelector<HTMLButtonElement>('.ai-ask-clear');
    const panel = launcher.querySelector<HTMLElement>('.ai-ask-panel');
    const form = launcher.querySelector<HTMLFormElement>('.ai-ask-form');
    const input = launcher.querySelector<HTMLInputElement>('.ai-ask-input');
    const output = launcher.querySelector<HTMLElement>('.ai-ask-result');
    if (!openButton || !closeButton || !panel || !form || !input || !output) return;

    const setOpen = (open: boolean) => {
      openButton.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (open) input.focus();
      else openButton.focus();
    };

    // 并发提交的状态。完全相同的问题重复提交直接忽略（双击场景，避免白跑一次生成）；
    // 换问题再提交则取消上一次 —— 否则两次响应会争抢同一输出区，且重复消耗生成额度。
    let inflight: { controller: AbortController; query: string } | null = null;

    // 客户端路由（ClientRouter）会在每次导航后重新执行本脚本，而 document 上的监听器
    // 不随页面卸载消失，会随导航次数累积（当前未启用 ClientRouter，属潜在问题）。
    // 解绑与请求取消都挂在 AbortController 上：换页时一并中止。
    const lifecycle = new AbortController();
    document.addEventListener(
      'astro:after-swap',
      () => {
        lifecycle.abort();
        inflight?.controller.abort();
      },
      { signal: lifecycle.signal },
    );

    openButton.addEventListener('click', () => {
      setOpen(panel.hidden);
    });

    closeButton.addEventListener('click', () => setOpen(false));

    // 面板不遮挡页面，故只在按 Esc 与点击面板外部时收起，而不是做成模态。
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && !panel.hidden) setOpen(false);
      },
      { signal: lifecycle.signal },
    );

    document.addEventListener(
      'pointerdown',
      (event) => {
        if (panel.hidden) return;
        const target = event.target as Node;
        if (!launcher.contains(target)) setOpen(false);
      },
      { signal: lifecycle.signal },
    );

    /**
     * 执行一次提问：登记在途请求、渲染加载态、按链路取答案；失败时给出可重试提示。
     * 换问题时先中止上一次 —— 否则两次响应会争抢同一输出区，也白费一次生成额度。
     */
    const submitQuery = async (query: string) => {
      inflight?.controller.abort();
      const controller = new AbortController();
      inflight = { controller, query };
      const { signal } = controller;

      renderStatus(panel, output, panel.dataset.pending ?? '');

      try {
        if (panel.dataset.recall === 'true') {
          await askWithLocalRecall(panel, output, query, signal);
        } else {
          await askNlweb(panel, output, query, signal);
        }
      } catch (error) {
        // 主动取消（换问题重问）不算失败，也不去改写新请求的输出
        if (signal.aborted) return;
        const quota = error instanceof AskRequestError && error.status === 429;
        renderFailure(
          panel,
          output,
          (quota ? panel.dataset.quota : panel.dataset.failed) ?? '',
          // 额度耗尽重试无意义（次日才重置）；其余失败给出重试入口
          quota ? undefined : () => void submitQuery(query),
        );
      } finally {
        if (inflight?.controller === controller) inflight = null;
      }
    };

    // 中文输入法选词时按回车不应提交：composition 期间的 submit 直接忽略
    let composing = false;
    input.addEventListener('compositionstart', () => {
      composing = true;
    });
    input.addEventListener('compositionend', () => {
      composing = false;
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (composing) return;
      const query = input.value.trim();
      if (!query) return;
      if (inflight?.query === query) return;
      void submitQuery(query);
    });

    clearButton?.addEventListener('click', () => {
      inflight?.controller.abort();
      inflight = null;
      output.replaceChildren();
      input.value = '';
      clearButton.hidden = true;
      input.focus();
    });
  });
</script>

<style>
  .ai-ask-launcher {
    position: fixed;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .ai-ask-open {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1;
    cursor: pointer;
  }

  .ai-ask-open:hover,
  .ai-ask-open[aria-expanded='true'] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .ai-ask-open:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* 窄屏只留图标，避免遮挡正文右下角。 */
  @media (max-width: 50rem) {
    .ai-ask-open {
