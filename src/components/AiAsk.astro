---
/**
 * 全站问答的悬浮入口。
 *
 * 问答检索的是全站 Pagefind 索引，与「复制 Markdown / 在 ChatGPT 中打开」这类
 * 只作用于当前文档的操作不同源。此前两者并列在标题区，容易被理解为「问当前
 * 文档」，故把问答拆成全局悬浮入口：任意页面都可发起提问，首页与博客列表也
 * 不再缺失入口。
 */
const t = Astro.locals.t;

/**
 * 问答链路有两套，取决于是否配置了自建生成端。
 *
 * 配置 PUBLIC_AI_ANSWER_URL 时走「浏览器端 Pagefind 召回 + 自建生成端」：
 * Pagefind 索引在构建期生成，中文分词可用，召回在客户端完成且不消耗
 * Workers AI 额度，生成端只负责依据片段作答。
 *
 * 未配置时回退到 NLWeb 的 /ask：英文与标识符可用，含中文的查询会被
 * NLWeb 侧过滤，见 adr/2026-09-14-AI-Search-容量限流调优.md §6.3。
 */
const answerEndpoint = import.meta.env.PUBLIC_AI_ANSWER_URL ?? '';
const nlwebEndpoint =
  import.meta.env.PUBLIC_NLWEB_ASK_URL ??
  'https://bold-union-4896-nlweb.iuinin666.workers.dev/ask';
const useLocalRecall = Boolean(answerEndpoint);
const askEndpoint = useLocalRecall ? answerEndpoint : nlwebEndpoint;
---

<div class="ai-ask-launcher">
  <div
    class="ai-ask-panel"
    hidden
    data-endpoint={askEndpoint}
    data-recall={String(useLocalRecall)}
    data-pending={t('aiAsk.pending')}
    data-empty={t('aiAsk.empty')}
    data-failed={t('aiAsk.failed')}
    data-sources={t('aiAsk.sources')}
  >
    <div class="ai-ask-head">
      <p class="ai-ask-title">{t('aiAsk.title')}</p>
      <button type="button" class="ai-ask-close" aria-label={t('aiAsk.close')}>
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <p class="ai-ask-hint">{t('aiAsk.hint')}</p>

    <form class="ai-ask-form">
      <input
        class="ai-ask-input"
        type="search"
        name="query"
        required
        placeholder={t('aiAsk.placeholder')}
      />
      <button class="ai-ask-submit" type="submit">{t('aiAsk.submit')}</button>
    </form>

    <div class="ai-ask-result" role="status" aria-live="polite"></div>
  </div>

  <button type="button" class="ai-ask-open" aria-expanded="false" title={t('aiAsk.label')}>
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 8.5-8.5h.5a8.5 8.5 0 0 1 8 8v.5z"
      ></path>
    </svg>
    <span class="ai-ask-open-text">{t('aiAsk.label')}</span>
  </button>
</div>

<script>
  interface AskResult {
    url?: string;
    name?: string;
    description?: string;
  }

  interface AskMessage {
    message_type?: string;
    results?: AskResult[];
    content?: string;
    answer?: string;
  }

  /** 交给生成端的片段。URL 需为绝对地址，生成端据此校验片段归属。 */
  interface AnswerContext {
    url: string;
    title: string;
    text: string;
  }

  interface PagefindResultData {
    url: string;
    content: string;
    excerpt: string;
    meta?: { title?: string };
  }

  /** 命中项。`id` 用于多次检索之间的结果融合。 */
  interface PagefindHit {
    id: string;
    data(): Promise<PagefindResultData>;
  }

  interface PagefindModule {
    init(): Promise<void>;
    search(query: string): Promise<{ results: PagefindHit[] }>;
  }

  /** 把 SSE 文本流切成完整的 `data:` 事件载荷。 */
  function parseEvents(chunk: string): AskMessage[] {
    const messages: AskMessage[] = [];
    for (const block of chunk.split('\n\n')) {
      for (const line of block.split('\n')) {
        if (!line.startsWith('data:')) continue;
        const payload = line.slice(5).trim();
        if (!payload || payload === '[DONE]') continue;
        try {
          messages.push(JSON.parse(payload) as AskMessage);
        } catch {
          // 心跳或非 JSON 行直接忽略
        }
      }
    }
    return messages;
  }

  function stripMarkup(text: string): string {
    return text.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  }

  /** 中文虚词与疑问词。长句检索时剔除，避免高频虚词占掉匹配名额。 */
  const STOP_TERMS = new Set([
    '的', '了', '是', '吗', '呢', '啊', '吧', '我', '你', '它', '这', '那',
    '有', '在', '和', '与', '或', '就', '也', '很', '到', '要', '会', '着',
    '被', '把', '给', '对', '个', '们', '请', '问', '怎么', '怎样', '如何',
    '什么', '哪些', '哪个', '为什么', '可以', '能否', '有没有', '多少',
  ]);

  interface WordSegmenter {
    segment(input: string): Iterable<{ segment: string }>;
  }

  /** 浏览器原生中文分词；不支持时返回 null，调用方退回按空白切分。 */
  function createSegmenter(): WordSegmenter | null {
    const ctor = (
      Intl as unknown as {
        Segmenter?: new (locale: string, options: { granularity: string }) => WordSegmenter;
      }
    ).Segmenter;
    return ctor ? new ctor('zh', { granularity: 'word' }) : null;
  }

  /**
   * 把长句拆成可独立检索的词，剔除虚词与单字。
   *
   * 单字一律剔除：中文单字由 `一-鿿` 判定，拉丁字母与数字单字由末位规则判定。
   * 拉丁单字必须剔除——Pagefind 对单字母有命中，`qqqzzzxxy` 被切成 `q`/`z`/`x`/`y`
   * 后各自都能召回，融合结果全是噪声。
   */
  function splitTerms(query: string): string[] {
    const segmenter = createSegmenter();
    const parts = segmenter
      ? [...segmenter.segment(query)].map((item) => item.segment)
      : query.split(/\s+/);
    return [...new Set(parts)].map((term) => term.trim()).filter(isSearchableTerm);
  }

  function isSearchableTerm(term: string): boolean {
    if (term.length === 0 || STOP_TERMS.has(term)) return false;
    if (/^[一-鿿]$/.test(term)) return false;
    return !/^[a-z0-9]$/i.test(term);
  }

  /**
   * 多词分别检索后融合排名（RRF）：被越多词命中、且在各自结果中越靠前的
   * 片段排得越前。不同查询的分数不可直接比较，故只用名次。
   */
  function fuseRankings(lists: string[][]): string[] {
    const scores = new Map<string, number>();
    for (const list of lists) {
      list.forEach((id, index) => {
        scores.set(id, (scores.get(id) ?? 0) + 1 / (60 + index + 1));
      });
    }
    return [...scores.entries()].sort((a, b) => b[1] - a[1]).map(([id]) => id);
  }

  function buildSources(label: string, items: AskResult[]): DocumentFragment {
    const fragment = document.createDocumentFragment();

    if (items.length > 0) {
      const heading = document.createElement('p');
      heading.className = 'ai-ask-sources';
      heading.textContent = label;
      fragment.append(heading);

      const list = document.createElement('ol');
      for (const item of items) {
        if (!item.url) continue;
        const entry = document.createElement('li');
        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.name ?? item.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        entry.append(link);
        if (item.description) {
          const text = document.createElement('p');
          text.textContent = item.description;
          entry.append(text);
        }
        list.append(entry);
      }
      fragment.append(list);
    }

    return fragment;
  }

  /**
   * 取覆盖查询词最多的窗口作为片段。
   *
   * 页面正文常达数千字符，而生成端只接收前 1500 字符。命中位置靠后时直接取开头
   * 会把相关内容整个切掉：nsenter 页正文 3062 字符，「持久化」位于第 2822 位，
   * 取开头导致模型只能回答「未在文档中找到相关内容」。
   */
  function bestWindow(text: string, terms: string[]): string {
    const size = 1500;
    if (text.length <= size || terms.length === 0) return text.slice(0, size);
    const step = 500;
    const last = Math.max(0, text.length - size);

    const scoreOf = (start: number) => {
      const window = text.slice(start, start + size);
      let score = 0;
      for (const term of terms) {
        if (window.toLowerCase().includes(term.toLowerCase())) score += 1;
      }
      return { window, score };
    };

    let best = text.slice(0, size);
    let bestScore = -1;

    // 起点上界为 last：原先写成 text.length + step，落在末尾之外的起点会切出
    // 短于 size 的窗口 —— 既少了上下文，也可能因为「短窗口同样命中」被评为最佳。
    for (let start = 0; start <= last; start += step) {
      const { window, score } = scoreOf(start);
      if (score > bestScore) {
        bestScore = score;
        best = window;
      }
    }

    // 正文结尾常是结论或关键配置，而步长网格可能刚好错过它，补一个末尾对齐的窗口
    if (last % step !== 0) {
      const { window, score } = scoreOf(last);
      if (score > bestScore) best = window;
    }

    return best;
  }

  /**
   * 浏览器端召回。Pagefind 索引由构建期生成，中文分词可用；
   * `astro dev` 下没有该产物，调用会失败并由调用方回退或提示。
   */
  async function localRecall(query: string, limit = 6) {
    const modulePath = '/pagefind/pagefind.js';
    const pagefind = (await import(/* @vite-ignore */ modulePath)) as unknown as PagefindModule;
    await pagefind.init();

    const terms = splitTerms(query);
    let found: PagefindHit[] = (await pagefind.search(query)).results.slice(0, limit);

    // Pagefind 对多个词要求同时命中同一文档，因此长句里只要有一个词与文档无关，
    // 结果就是 0。实测「nsenter 的改动是持久化的吗」为 0，而拆出的
    // 「nsenter」「持久」分别有 3 条与 4 条命中。故整句无结果时改为
    // 按词分别检索，再融合排名。
    if (found.length === 0) {
      if (terms.length > 0) {
        const lists: string[][] = [];
        const pool = new Map<string, PagefindHit>();
        for (const term of terms) {
          const search = await pagefind.search(term);
          lists.push(search.results.map((item) => item.id));
          for (const item of search.results) {
            if (!pool.has(item.id)) pool.set(item.id, item);
          }
        }
        found = fuseRankings(lists)
          .slice(0, limit)
          .map((id) => pool.get(id))
          .filter((item): item is PagefindHit => Boolean(item));
      }
    }

    const picked = await Promise.all(found.map((result) => result.data()));

    const hits: AskResult[] = [];
    const contexts: AnswerContext[] = [];
    for (const item of picked) {
      const url = new URL(item.url, window.location.origin).href;
      const title = item.meta?.title ?? item.url;
      hits.push({ url, name: title, description: stripMarkup(item.excerpt ?? '') });
      const text = stripMarkup(item.content ?? '');
      contexts.push({ url, title, text: bestWindow(text, terms.length > 0 ? terms : [query]) });
    }
    return { hits, contexts };
  }

  /** 逐段读取 SSE，把解析出的消息交给调用方。 */
  async function readStream(response: Response, onMessage: (message: AskMessage) => void) {
    if (!response.body) throw new Error('empty body');
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';

    try {
      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const boundary = buffer.lastIndexOf('\n\n');
        if (boundary === -1) continue;
        const complete = buffer.slice(0, boundary + 2);
        buffer = buffer.slice(boundary + 2);
        for (const message of parseEvents(complete)) onMessage(message);
      }
    } finally {
      // 正常结束、上游出错、被 abort 中断三条路径都要还锁：
      // 取消时若不还锁，底层流不会尽快释放回连接池。
      reader.releaseLock();
    }
  }

  /**
   * 本地召回 + 自建生成端：中文查询可用。
   *
   * `signal` 来自当前这次提交：被后一次提交取消后，本函数不得再改动界面，
   * 否则旧请求的输出会盖掉新请求的（答案与来源错配的成因之一）。
   */
  async function askWithLocalRecall(
    panel: HTMLElement,
    output: HTMLElement,
    query: string,
    signal: AbortSignal,
  ) {
    const { hits, contexts } = await localRecall(query);

    if (signal.aborted) return;

    if (hits.length === 0) {
      output.textContent = panel.dataset.empty ?? '';
      return;
    }

    output.replaceChildren();
    const answer = document.createElement('p');
    answer.className = 'ai-ask-answer';
    output.append(answer);
    output.append(buildSources(panel.dataset.sources ?? '', hits));

    const response = await fetch(panel.dataset.endpoint ?? '', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query, contexts }),
      signal,
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);

    await readStream(response, (message) => {
      if (signal.aborted) return;
      const text = message.answer ?? message.content;
      if (typeof text === 'string' && text) answer.textContent += text;
    });

    if (!signal.aborted && !answer.textContent) answer.textContent = panel.dataset.empty ?? '';
  }

  /** 回退路径：NLWeb 自行检索并生成，中文查询会被其过滤。 */
  async function askNlweb(
    panel: HTMLElement,
    output: HTMLElement,
    query: string,
    signal: AbortSignal,
  ) {
    const collected: AskResult[] = [];
    const notes: string[] = [];

    const response = await fetch(panel.dataset.endpoint ?? '', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query, mode: 'generate', site: 'all' }),
      signal,
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);

    await readStream(response, (message) => {
      if (signal.aborted) return;
      if (message.results) collected.push(...message.results);
      const text = message.answer ?? message.content;
      if (typeof text === 'string' && text) notes.push(text);
    });

    if (signal.aborted) return;

    output.replaceChildren();
    const answer = document.createElement('p');
    answer.textContent = notes.join(' ');
    output.append(answer);
    output.append(buildSources(panel.dataset.sources ?? '', collected));
  }

  document.querySelectorAll<HTMLElement>('.ai-ask-launcher').forEach((launcher) => {
    const openButton = launcher.querySelector<HTMLButtonElement>('.ai-ask-open');
    const closeButton = launcher.querySelector<HTMLButtonElement>('.ai-ask-close');
    const panel = launcher.querySelector<HTMLElement>('.ai-ask-panel');
    const form = launcher.querySelector<HTMLFormElement>('.ai-ask-form');
    const input = launcher.querySelector<HTMLInputElement>('.ai-ask-input');
    const output = launcher.querySelector<HTMLElement>('.ai-ask-result');
    if (!openButton || !closeButton || !panel || !form || !input || !output) return;

    const setOpen = (open: boolean) => {
      openButton.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (open) input.focus();
      else openButton.focus();
    };

    // 并发提交的状态。完全相同的问题重复提交直接忽略（双击场景，避免白跑一次生成）；
    // 换问题再提交则取消上一次 —— 否则两次响应会争抢同一输出区，且重复消耗生成额度。
    let inflight: { controller: AbortController; query: string } | null = null;

    // 客户端路由（ClientRouter）会在每次导航后重新执行本脚本，而 document 上的监听器
    // 不随页面卸载消失，会随导航次数累积（当前未启用 ClientRouter，属潜在问题）。
    // 解绑与请求取消都挂在 AbortController 上：换页时一并中止。
    const lifecycle = new AbortController();
    document.addEventListener(
      'astro:after-swap',
      () => {
        lifecycle.abort();
        inflight?.controller.abort();
      },
      { signal: lifecycle.signal },
    );

    openButton.addEventListener('click', () => {
      setOpen(panel.hidden);
    });

    closeButton.addEventListener('click', () => setOpen(false));

    // 面板不遮挡页面，故只在按 Esc 与点击面板外部时收起，而不是做成模态。
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && !panel.hidden) setOpen(false);
      },
      { signal: lifecycle.signal },
    );

    document.addEventListener(
      'pointerdown',
      (event) => {
        if (panel.hidden) return;
        const target = event.target as Node;
        if (!launcher.contains(target)) setOpen(false);
      },
      { signal: lifecycle.signal },
    );

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const query = input.value.trim();
      if (!query) return;
      if (inflight?.query === query) return;

      inflight?.controller.abort();
      const controller = new AbortController();
      inflight = { controller, query };
      const { signal } = controller;

      output.textContent = panel.dataset.pending ?? '';

      try {
        if (panel.dataset.recall === 'true') {
          await askWithLocalRecall(panel, output, query, signal);
        } else {
          await askNlweb(panel, output, query, signal);
        }
      } catch {
        // 主动取消（换问题重问）不算失败，也不去改写新请求的输出
        if (!signal.aborted) output.textContent = panel.dataset.failed ?? '';
      } finally {
        if (inflight?.controller === controller) inflight = null;
      }
    });
  });
</script>

<style>
  .ai-ask-launcher {
    position: fixed;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .ai-ask-open {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1;
    cursor: pointer;
  }

  .ai-ask-open:hover,
  .ai-ask-open[aria-expanded='true'] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .ai-ask-open:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* 窄屏只留图标，避免遮挡正文右下角。 */
  @media (max-width: 50rem) {
    .ai-ask-open {
      padding: 0.7rem;
    }

    .ai-ask-open-text {
      display: none;
    }
  }

  .ai-ask-panel {
    width: min(24rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100vh - 8rem));
    overflow-y: auto;
    padding: 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background-color: var(--sl-color-bg-nav);
    font-size: var(--sl-text-xs);
  }

  .ai-ask-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .ai-ask-title {
    margin: 0;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .ai-ask-close {
    display: inline-flex;
    padding: 0.2rem;
    border: none;
    border-radius: 0.35rem;
    background-color: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  .ai-ask-close:hover {
    color: var(--sl-color-white);
  }

  .ai-ask-hint {
    margin: 0.35rem 0 0;
    color: var(--sl-color-gray-3);
    line-height: 1.6;
  }

  .ai-ask-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .ai-ask-input {
    flex: 1 1 12rem;
    min-width: 0;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
  }

  .ai-ask-input:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .ai-ask-submit {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    cursor: pointer;
  }

  .ai-ask-submit:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .ai-ask-result {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
    line-height: 1.7;
  }

  .ai-ask-result :global(ol) {
    margin: 0;
